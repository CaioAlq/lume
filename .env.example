# Como usar: cp .env.example .env  e troque os valores marcados.
# O .env fica fora do git; este arquivo é o contrato do que precisa existir.
# Conferir se está completo: docker compose --env-file .env.example config

# Senha do banco. Troque. Use só letras e números: um $ vira outra variável
# e um espaço seguido de # vira comentário; o Compose corta a senha sem avisar.
DB_PASSWORD=add-a-password

# Nome do banco criado na primeira subida.
DB_NAME=lume

# Porta do banco (só o número). Dentro do container o Postgres
# sempre escuta na 5432; o compose.yaml já faz essa ligação.
# Mude só se a 5432 estiver ocupada.
DB_PORT=5432
