// Opções comuns a todos os pacotes TypeScript do workspace. Tipos de runtime (ex.: Bun)
// ficam no tsconfig de cada app, porque o packages/shared também vai ser usado pelo web.
{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Variável, import ou parâmetro sem uso é erro no typecheck.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Some stricter flags (disabled by default)
    "noPropertyAccessFromIndexSignature": false
  }
}
